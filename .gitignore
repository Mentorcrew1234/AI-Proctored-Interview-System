### Project ###
frontend/node_modules/
frontend/dist/
# Vite build output, regenerated by `npm run build`
src/main/resources/static/exam/
# MediaPipe WASM runtime (~33 MB) is copied out of node_modules at build time.
# The model weights under frontend/public/models ARE committed, so the
# interview runs with no internet access.
frontend/public/wasm/
# local secrets: DB password, Gemini API key (repo-root config/application.yml only -
# the leading slash matters, or this also matches src/.../config/ Java packages)
.env
application-local.yml
/config/

# graphify knowledge-graph output - 20 MB, fully regenerable with /graphify.
# Leading slash on purpose: a bare pattern matches at every level (see CLAUDE.md,
# the .gitignore gotcha that silently untracked the Java config package).
/graphify-out/
