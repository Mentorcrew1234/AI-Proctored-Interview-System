# Copy this file to docker/.env and fill in real values.
# docker/.env is for local Docker testing only - it is NOT the same file as
# the repo-root config/application.yml the bare-metal deployment uses, and it
# should never be committed (add docker/.env to your local git excludes).

# Required
DB_PASSWORD=change-me-to-a-strong-password
JWT_SECRET=change-me-to-at-least-32-random-characters

# Optional - sensible defaults are used if left blank
DB_NAME=proctor_interview
INTERVIEW_MODE=NORMAL
INTERVIEW_AI_MODE=MOCK
INTERVIEW_QUESTION_MODE=FIXED
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
